{
  "name": "@yawnwest/pixel-css",
  "version": "0.4.2",
  "description": "This is a CSS learning project for pixel-art like websites.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yawnwest/pixel-css"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode demo",
    "serve": "vite dev --host --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "pnpm build && vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "size": "pnpm build && size-limit"
  },
  "keywords": [
    "CSS Library",
    "Pixel Art"
  ],
  "author": "Yawn West",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@fontsource/press-start-2p": "^5.2.7",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,md,json}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "1 kB"
    },
    {
      "path": "dist/style.css",
      "limit": "25 kB"
    }
  ]
}
